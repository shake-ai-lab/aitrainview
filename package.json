{
  "name": "aitrainview",
  "version": "0.1.0",
  "description": "3D viewer for LLM weights, architecture, inference and fine-tuning",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build --config frontend/vite.config.ts",
    "app:build": "tauri build --no-bundle",
    "app:installer": "tauri build",
    "web": "vite --config frontend/vite.config.ts",
    "backend": "node scripts/py.mjs backend/run.py",
    "typecheck": "tsc -p frontend --noEmit",
    "test:backend": "node scripts/py.mjs -m unittest discover -s backend/tests",
    "check": "npm run typecheck && npm run test:backend",
    "tauri": "tauri"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
